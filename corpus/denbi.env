# de.NBI Tübingen S3 target for the corpus sync scripts.
# Flips push-data-stackit.sh / push-index-stackit.sh from StackIT to de.NBI:
#     set -a; source corpus/denbi.env; set +a
#     DRYRUN=1 bash corpus/push-data-stackit.sh      # verify plan first
#
# Prereq — an aws profile 'denbi' holding your de.NBI EC2 credentials (kept out of this repo):
#     aws configure --profile denbi
#       AWS Access Key ID     : <EC2 access key>     # dashboard > API Zugriff > Zugangsdaten ansehen
#       AWS Secret Access Key : <EC2 secret key>     #   (EC2 credentials section)
#       Default region name   : us-east-1            # RGW ignores it; any value is fine
#       Default output format  : json
#
# Endpoints (from the project's API-access catalog, verified live):
#   EC2/S3-compat : https://s3.denbi.uni-tuebingen.de   (Ceph RGW; EC2 creds authenticate here)
#   S3 service    : https://ms24.denbi.uni-tuebingen.de (alternate host, also live S3)
export AWS_PROFILE=denbi
export ENDPOINT=https://s3.denbi.uni-tuebingen.de
export BUCKET=mzpeak                 # create once:  aws --profile denbi --endpoint-url "$ENDPOINT" s3 mb s3://mzpeak

# Public browsable links in the generated site point here. Path-style URL against the RGW host;
# requires the bucket to carry a public-read policy (otherwise links 403). Leave commented to keep
# the StackIT object-storage base in generated pages until de.NBI public-read is set up.
# export CDN_BASE="https://s3.denbi.uni-tuebingen.de/${BUCKET}"
